generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

model User {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  email        String   @unique
  name         String
  role         Role
  active       Boolean  @default(true)
  hashPassword String

  @@map("users")
}

enum Role {
  ATENDENTE
  ADMIN
}
