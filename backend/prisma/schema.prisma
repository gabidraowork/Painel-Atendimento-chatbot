generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

model User {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  email        String   @unique
  name         String
  role         Role
  active       Boolean  @default(true)
  hashPassword String
  apiKeys      ApiKey[]
  clients      Client[]

  @@map("users")
}

model Client {
  id          Int      @id @default(autoincrement())
  phone       String
  name        String
  attendantId Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  answered    Boolean  @default(false)
  attendant   User     @relation(fields: [attendantId], references: [id])

  @@unique([attendantId, phone])
  @@index([attendantId])
  @@map("clients")
}

model ApiKey {
  id        Int      @id @default(autoincrement())
  name      String
  keyHash   String   @unique
  userId    Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "api_keys_userId_fkey")
  @@map("api_keys")
}

enum Role {
  ATENDENTE
  ADMIN
}
